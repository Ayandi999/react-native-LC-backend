PORT=8080
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-better-auth-secret-key-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:8080"

# Social Authentication - Google
# Web & Native client credentials from Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Social Authentication - GitHub
# OAuth App credentials from GitHub Developer Settings
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Redis Configuration (for Phase 2 WebSocket session cache)
REDIS_URL="redis://localhost:6379"

# AI Provider API Key (e.g. Gemini / OpenAI)
GEMINI_API_KEY="your-gemini-api-key"
